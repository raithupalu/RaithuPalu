+    },
+    timeSlot: {
+      type: String,
+      enum: ["morning", "evening"],
+      default: "morning",
+    },
+    frequency: {
+      type: String,
+      enum: ["daily", "alternate", "weekly"],
+      default: "daily",
+    },
+    isActive: {
+      type: Boolean,
+      default: true,
+      index: true, // Fast querying for midnight delivery logging
+    },
+    notes: String,
+    updatedAt: {
+      type: Date,
+      default: Date.now,
+    }
+  },
+  { timestamps: true }
+);
+
+module.exports = mongoose.model("Subscription", subscriptionSchema);
