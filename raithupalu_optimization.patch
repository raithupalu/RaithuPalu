+const mongoose = require("mongoose");
+
+const subscriptionSchema = new mongoose.Schema(
+  {
+    userId: {
+      type: mongoose.Schema.Types.ObjectId,
+      ref: "User",
+      required: [true, "User ID is required"],
+      unique: true, // A customer has one active subscription plan
+      index: true,
